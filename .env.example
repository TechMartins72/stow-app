# Copy to .env and fill in. .env is gitignored.

# mock (default) or live. Live moves real funds.
GATEWAY_MODE=mock

# Mock Gateway (npm run mock)
MOCK_GATEWAY_URL=http://localhost:4010

# Live Gateway
TM_API_BASE=https://api.truemarkets.co
# Each key is given EITHER as a file path (your computer) OR as the file's contents
# (hosts without files, like Vercel). If both are set, the contents win.
#
# Organization API key file downloaded from https://console.truemarkets.co
TM_KEY_FILE=.secrets/api-key.json
# TM_API_KEY={"key_id":"...","private_key":{...}}   <- whole file, on Vercel (mark it Sensitive)
#
# Signer key (npm run dev:signer-key). Back it up: it can never be rotated, and every
# live account is tied to it for good.
SIGNER_KEY_FILE=.secrets/signer-key.json
# SIGNER_KEY={"signer_public_key":"...","signer_private_key":"..."}   <- whole file, on Vercel (Sensitive)

# Dev scripts
DEV_USER_REF=dev_user_1  # dev scripts only; the app uses signed-in users
ROUNDTRIP_USDC=1

# Postgres (Neon, Supabase or local)
# Supabase: Connect > Transaction pooler (port 6543). Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Sign-in (magic links). Links point at APP_URL, never at the request's Host header.
APP_URL=http://localhost:3000
# Resend: API Keys > Create (Sending access). The test sender only delivers to your own Resend address;
# verify a domain to email anyone. In practice mode links are also printed in the server terminal.
RESEND_API_KEY=re_...
EMAIL_FROM=Stow <onboarding@resend.dev>
